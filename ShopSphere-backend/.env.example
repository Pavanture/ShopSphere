# Copy this file to .env (or export these as real environment variables)
# and NEVER commit actual secrets to version control.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere_db
DB_USERNAME=root
DB_PASSWORD=change-me

JWT_SECRET=replace-with-a-long-random-base64-secret-at-least-256-bits
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000

SERVER_PORT=8080
DDL_AUTO=update
SHOW_SQL=false
LOG_LEVEL=INFO

# Qikink sandbox order fulfillment (disabled until credentials and SKU mappings are set)
QIKINK_ENABLED=false
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_GATEWAY=COD
QIKINK_SHIPPING=1
